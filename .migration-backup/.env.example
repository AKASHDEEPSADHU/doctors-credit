APP_ENV=development
# DEMO_PAYMENTS is ignored in staging and production. Local only.
DEMO_PAYMENTS=true
# Required. Use a long random string (32+ characters) in staging/production.
SESSION_SECRET=change-me-to-a-long-random-string
# Public WhatsApp number in E.164 without "+". Leave unset to hide WhatsApp.
# NEXT_PUBLIC_WHATSAPP_E164=91XXXXXXXXXX

# Cloudflare Turnstile (required in staging/production)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Google Sign-In. Authorized redirect: {origin}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Dodo Payments: hosted Checkout Sessions only. Never store PAN/CVV.
# Required in staging/production. Missing keys must not mark applications paid.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_RETURN_URL=http://127.0.0.1:3100/success
# DODO_PRODUCT_ID_ORIENTATION=

# Google Sheets CRM replica (never the public site; never medical records)
# Use a *development* spreadsheet locally. Production sheet ID must not be used
# unless APP_ENV=production.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_PRODUCTION_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional transactional email (Resend). If unset, confirmation stays on /account and /success.
# RESEND_API_KEY=
# TRANSACTIONAL_FROM_EMAIL=DCredit <care@dcredit.in>

# V1 published conversation timezone (not a live staff calendar).
# DCREDIT_SCHEDULE_TIMEZONE=America/New_York
# DCREDIT_SCHEDULE_TIMEZONE_LABEL=Eastern Time
# DCREDIT_SLOT_CAPACITY=1

# Zoom Server-to-Server OAuth (server-side only). Leave unset until configured.
# Meetings are created only after a verified Dodo payment.succeeded webhook.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Coordinator desk: shared operational credential. Never commit the live value.
# Use 24+ characters in staging/production.
# STAFF_API_SECRET=
